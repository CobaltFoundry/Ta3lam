{"id":"ln-l0-u1-03","track":"learner","pass_score":0.8,"title":{"ar":"الحروف: ذ ر ز س","en":"Letters: ذ ر ز س","fr":"Lettres : ذ ر ز س"},"teach":[{"type":"text","text":"Letters 9–12 of 28. Look at the dots: they are what tells many letters apart."},{"type":"letter","ch":"ذ","name":"dhaal","sound":"dh (as in 'this')","note":"Same as د with one dot above.","dots":"one dot above","forms":{"iso":"ذ","fin":"‍ذ"},"word":{"ar":"ذُرَة","en":"corn"}},{"type":"letter","ch":"ر","name":"raa","sound":"r (a quick rolled 'r')","note":"A curve dropping below the line. Does not connect forward.","dots":"no dots","forms":{"iso":"ر","fin":"‍ر"},"word":{"ar":"رَجُل","en":"man"}},{"type":"letter","ch":"ز","name":"zaay","sound":"z","note":"Same as ر with one dot above.","dots":"one dot above","forms":{"iso":"ز","fin":"‍ز"},"word":{"ar":"زَهْرَة","en":"flower"}},{"type":"letter","ch":"س","name":"seen","sound":"s","note":"Three small teeth, no dots.","dots":"no dots","forms":{"iso":"س","fin":"‍س","ini":"س‍","med":"‍س‍"},"word":{"ar":"سَمَكَة","en":"fish"}}],"practice":[{"type":"mcq","prompt":"Which letter is called «dhaal»?","options":["ر","ز","ذ","س"],"answer":2,"explain":"ذ is called dhaal.","id":"ln-l0-u1-03_p1"},{"type":"mcq","prompt":"What is the name of this letter: ر","options":["zaay","raa","dhaal","seen"],"answer":1,"explain":"ر is called raa.","id":"ln-l0-u1-03_p2"},{"type":"match","prompt":"Match each letter to its name","pairs":[["ذ","dhaal"],["ر","raa"],["ز","zaay"],["س","seen"]],"explain":"Look at the shape and the dots.","id":"ln-l0-u1-03_p3"},{"type":"mcq","prompt":"The word زَهْرَة means:","options":["corn","man","fish","flower"],"answer":3,"explain":"زَهْرَة = flower. It starts with ز.","id":"ln-l0-u1-03_p4"}],"quiz":[{"type":"mcq","prompt":"Which letter makes this sound: s","options":["س","ذ","ز","ر"],"answer":0,"explain":"س (seen) = s.","id":"ln-l0-u1-03_q1"},{"type":"mcq","prompt":"How many dots does ر have, and where?","options":["Two dots below","One dot above","No dots","Two dots above"],"answer":2,"explain":"ر has no dots.","id":"ln-l0-u1-03_q2"},{"type":"mcq","prompt":"What is the name of this letter: ز","options":["raa","seen","dhaal","zaay"],"answer":3,"explain":"ز is called zaay.","id":"ln-l0-u1-03_q3"},{"type":"tf","prompt":"True or false: ذ is called \"dhaal\".","answer":true,"explain":"Correct, ذ is dhaal.","id":"ln-l0-u1-03_q4"},{"type":"type","prompt":"Type the name of this letter (in English letters): س","answers":["seen"],"explain":"س is called seen.","id":"ln-l0-u1-03_q5"},{"type":"mcq","prompt":"The word رَجُل means:","options":["corn","man","fish","flower"],"answer":1,"explain":"رَجُل = man.","id":"ln-l0-u1-03_q6"},{"type":"mcq","prompt":"Which word starts with the letter ز?","options":["زَهْرَة","ذُرَة","سَمَكَة","رَجُل"],"answer":0,"explain":"زَهْرَة (flower) starts with ز.","id":"ln-l0-u1-03_q7"},{"type":"mcq","prompt":"What sound does ذ make?","options":["s","r (a quick rolled 'r')","z","dh (as in 'this')"],"answer":3,"explain":"ذ (dhaal) = dh (as in 'this').","id":"ln-l0-u1-03_q8"}]}