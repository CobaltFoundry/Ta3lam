{"id": "ln-l0-u1-04", "title": {"ar": "الحروف: ش ص ض ط", "en": "Letters: ش ص ض ط", "fr": "Lettres : ش ص ض ط"}, "teach": [{"type": "text", "text": "Lettres 13 à 16 sur 28. Regardez les points : ce sont eux qui permettent de distinguer beaucoup de lettres."}, {"type": "letter", "ch": "ش", "name": "sheen", "sound": "sh", "note": "Les mêmes dents que س avec trois points au-dessus.", "dots": "trois points au-dessus", "forms": {"iso": "ش", "fin": "‍ش", "ini": "ش‍", "med": "‍ش‍"}, "word": {"ar": "شَمْس", "en": "soleil"}}, {"type": "letter", "ch": "ص", "name": "Saad", "sound": "un « s » lourd et emphatique", "note": "Une boucle avec une queue, sans points. Prononcez-le au fond de la bouche.", "dots": "aucun point", "forms": {"iso": "ص", "fin": "‍ص", "ini": "ص‍", "med": "‍ص‍"}, "word": {"ar": "صَبَاح", "en": "matin"}}, {"type": "letter", "ch": "ض", "name": "Daad", "sound": "un « d » lourd et emphatique", "note": "Comme ص avec un point au-dessus. L’arabe est appelé « la langue du Daad ».", "dots": "un point au-dessus", "forms": {"iso": "ض", "fin": "‍ض", "ini": "ض‍", "med": "‍ض‍"}, "word": {"ar": "ضِفْدَع", "en": "grenouille"}}, {"type": "letter", "ch": "ط", "name": "Taa", "sound": "un « t » lourd et emphatique", "note": "Une boucle avec une tige haute, sans points.", "dots": "aucun point", "forms": {"iso": "ط", "fin": "‍ط", "ini": "ط‍", "med": "‍ط‍"}, "word": {"ar": "طَائِر", "en": "oiseau"}}], "practice": [{"type": "mcq", "prompt": "Quelle lettre s’appelle « sheen » ?", "options": ["ض", "ط", "ش", "ص"], "answer": 2, "explain": "ش s’appelle sheen.", "id": "ln-l0-u1-04_p1"}, {"type": "mcq", "prompt": "Quel est le nom de cette lettre : ص", "options": ["Taa", "Saad", "Daad", "sheen"], "answer": 1, "explain": "ص s’appelle Saad.", "id": "ln-l0-u1-04_p2"}, {"type": "match", "prompt": "Associez chaque lettre à son nom", "pairs": [["ش", "sheen"], ["ص", "Saad"], ["ض", "Daad"], ["ط", "Taa"]], "explain": "Regardez la forme et les points.", "id": "ln-l0-u1-04_p3"}, {"type": "mcq", "prompt": "Le mot ضِفْدَع signifie :", "options": ["oiseau", "matin", "grenouille", "soleil"], "answer": 2, "explain": "ضِفْدَع = grenouille. Il commence par ض.", "id": "ln-l0-u1-04_p4"}], "quiz": [{"type": "mcq", "prompt": "Quelle lettre produit ce son : un « t » lourd et emphatique", "options": ["ص", "ض", "ش", "ط"], "answer": 3, "explain": "ط (Taa) = un « t » lourd et emphatique.", "id": "ln-l0-u1-04_q1"}, {"type": "mcq", "prompt": "Combien de points a ص, et où ?", "options": ["Trois points au-dessus", "Un point en dessous", "Deux points au-dessus", "Aucun point"], "answer": 3, "explain": "ص n’a aucun point.", "id": "ln-l0-u1-04_q2"}, {"type": "mcq", "prompt": "Quel est le nom de cette lettre : ض", "options": ["sheen", "Saad", "Daad", "Taa"], "answer": 2, "explain": "ض s’appelle Daad.", "id": "ln-l0-u1-04_q3"}, {"type": "tf", "prompt": "Vrai ou faux : ش s’appelle « Saad ».", "answer": false, "explain": "ش s’appelle sheen ; Saad est ص.", "id": "ln-l0-u1-04_q4"}, {"type": "type", "prompt": "Tapez le nom de cette lettre (en lettres latines) : ط", "answers": ["Taa"], "explain": "ط s’appelle Taa.", "id": "ln-l0-u1-04_q5"}, {"type": "mcq", "prompt": "Le mot صَبَاح signifie :", "options": ["grenouille", "oiseau", "matin", "soleil"], "answer": 2, "explain": "صَبَاح = matin.", "id": "ln-l0-u1-04_q6"}, {"type": "mcq", "prompt": "Quel mot commence par la lettre ض ?", "options": ["صَبَاح", "ضِفْدَع", "شَمْس", "طَائِر"], "answer": 1, "explain": "ضِفْدَع (grenouille) commence par ض.", "id": "ln-l0-u1-04_q7"}, {"type": "mcq", "prompt": "Quel son produit ش ?", "options": ["sh", "un « t » lourd et emphatique", "un « s » lourd et emphatique", "un « d » lourd et emphatique"], "answer": 0, "explain": "ش (sheen) = sh.", "id": "ln-l0-u1-04_q8"}]}