{"id":"ln-l0-u1-05","track":"learner","pass_score":0.8,"title":{"ar":"الحروف: ظ ع غ ف","en":"Letters: ظ ع غ ف","fr":"Lettres : ظ ع غ ف"},"teach":[{"type":"text","text":"Letters 17–20 of 28. Look at the dots: they are what tells many letters apart."},{"type":"letter","ch":"ظ","name":"Zaa","sound":"a heavy, emphatic 'dh'","note":"Same as ط with one dot above.","dots":"one dot above","forms":{"iso":"ظ","fin":"‍ظ","ini":"ظ‍","med":"‍ظ‍"},"word":{"ar":"ظَرْف","en":"envelope"}},{"type":"letter","ch":"ع","name":"'ayn","sound":"a deep squeezed sound from the throat (no English equivalent)","note":"Looks like a small 3 or an open head. No dots.","dots":"no dots","forms":{"iso":"ع","fin":"‍ع","ini":"ع‍","med":"‍ع‍"},"word":{"ar":"عَيْن","en":"eye"}},{"type":"letter","ch":"غ","name":"ghayn","sound":"gh (like a French 'r', gargled)","note":"Same as ع with one dot above.","dots":"one dot above","forms":{"iso":"غ","fin":"‍غ","ini":"غ‍","med":"‍غ‍"},"word":{"ar":"غَيْمَة","en":"cloud"}},{"type":"letter","ch":"ف","name":"faa","sound":"f","note":"A small round head with one dot above.","dots":"one dot above","forms":{"iso":"ف","fin":"‍ف","ini":"ف‍","med":"‍ف‍"},"word":{"ar":"فِيل","en":"elephant"}}],"practice":[{"type":"mcq","prompt":"Which letter is called «Zaa»?","options":["ع","غ","ظ","ف"],"answer":2,"explain":"ظ is called Zaa.","id":"ln-l0-u1-05_p1"},{"type":"mcq","prompt":"What is the name of this letter: ع","options":["ghayn","Zaa","'ayn","faa"],"answer":2,"explain":"ع is called 'ayn.","id":"ln-l0-u1-05_p2"},{"type":"match","prompt":"Match each letter to its name","pairs":[["ظ","Zaa"],["ع","'ayn"],["غ","ghayn"],["ف","faa"]],"explain":"Look at the shape and the dots.","id":"ln-l0-u1-05_p3"},{"type":"mcq","prompt":"The word غَيْمَة means:","options":["elephant","envelope","eye","cloud"],"answer":3,"explain":"غَيْمَة = cloud. It starts with غ.","id":"ln-l0-u1-05_p4"}],"quiz":[{"type":"mcq","prompt":"Which letter makes this sound: f","options":["غ","ظ","ع","ف"],"answer":3,"explain":"ف (faa) = f.","id":"ln-l0-u1-05_q1"},{"type":"mcq","prompt":"How many dots does ع have, and where?","options":["No dots","Two dots above","One dot below","One dot above"],"answer":0,"explain":"ع has no dots.","id":"ln-l0-u1-05_q2"},{"type":"mcq","prompt":"What is the name of this letter: غ","options":["Zaa","faa","ghayn","'ayn"],"answer":2,"explain":"غ is called ghayn.","id":"ln-l0-u1-05_q3"},{"type":"tf","prompt":"True or false: ظ is called \"Zaa\".","answer":true,"explain":"Correct, ظ is Zaa.","id":"ln-l0-u1-05_q4"},{"type":"type","prompt":"Type the name of this letter (in English letters): ف","answers":["faa"],"explain":"ف is called faa.","id":"ln-l0-u1-05_q5"},{"type":"mcq","prompt":"The word عَيْن means:","options":["elephant","eye","cloud","envelope"],"answer":1,"explain":"عَيْن = eye.","id":"ln-l0-u1-05_q6"},{"type":"mcq","prompt":"Which word starts with the letter غ?","options":["غَيْمَة","فِيل","عَيْن","ظَرْف"],"answer":0,"explain":"غَيْمَة (cloud) starts with غ.","id":"ln-l0-u1-05_q7"},{"type":"mcq","prompt":"What sound does ظ make?","options":["f","a heavy, emphatic 'dh'","a deep squeezed sound from the throat (no English equivalent)","gh (like a French 'r', gargled)"],"answer":1,"explain":"ظ (Zaa) = a heavy, emphatic 'dh'.","id":"ln-l0-u1-05_q8"}]}